<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="model_test_model" model="ir.model">
        <field name="name">test.model</field>
        <field name="model">test.model</field>
    </record>

    <record id="cron_mark_confirm" model="ir.cron">
        <field name="name">Mark as Done</field>
        <field name="model_id" ref="model_test_model"/>
        <field name="state">code</field>
        <field name="code">env['test.model'].mark_confirm()</field>
        <field name="interval_number">5</field>
        <field name="interval_type">minutes</field>
        <field name="active" eval="True"/>
    </record>
</odoo>