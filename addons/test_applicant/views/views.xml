<odoo>
    
    <record id="view_test_model_list" model="ir.ui.view">
        <field name="name">test.model.list</field>
        <field name="model">test.model</field>
        <field name="arch" type="xml">
        <list string="Test Model">
            <field name="reference_code"/>
            <field name="name"/>
            <field name="state"/>
            <field name="active"/>
            <button name="action_confirm" type="object" string="Confirm" invisible="state in ('done', 'confirmed')"/>
        </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_test_model_form" model="ir.ui.view">
        <field name="name">test.model.form</field>
        <field name="model">test.model</field>
        <field name="arch" type="xml">
            <form string="Test Model">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="description"/>
                        <field name="reference_code" readonly="1"/>
                        <field name="state"/>
                        <field name="active"/>
                    </group>
                </sheet>
                <footer>
                    <!-- <button name="action_confirm" type="object" string="Confirm" class="oe_highlight"
                    modifiers="{'invisible': [('state', '=', 'confirmed')]}" /> -->
                </footer>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_test_model" model="ir.actions.act_window">
        <field name="name">Test Model</field>
        <field name="res_model">test.model</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Item -->
    <menuitem id="menu_test_applicant_root" name="Test Applicant" parent="base.menu_administration" /><!-- groups="base.group_system" parent="base.menu_management"-->
    <menuitem id="menu_test_model" name="Test Models" parent="menu_test_applicant_root"
              action="action_test_model" sequence="1"/>
</odoo>

